<Page x:Class="ScreenTranslator.App.Pages.HotkeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      FontFamily="{DynamicResource AppFontFamily}"
      FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,36,36"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <TextBlock Text="快捷键" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="在任何应用中唤起框选翻译，不需要先切换到屏译。"
                       Style="{StaticResource PageSubtitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="框选翻译" FontSize="17" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,10"
                                Margin="0,14,0,8"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding HotkeyText}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="恢复默认"
                               Command="{Binding RecordCommand}"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="启用全局快捷键" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="暂停时仍可从托盘菜单开始翻译。"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding IsEnabled}"
                                     VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ui:InfoBar Title="默认快捷键"
                        Message="当前版本固定使用 Alt + Shift + T；若被占用，仍可从托盘菜单开始框选翻译。"
                        Severity="Informational"
                        IsOpen="True"
                        Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
