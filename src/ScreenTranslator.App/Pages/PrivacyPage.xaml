<Page x:Class="ScreenTranslator.App.Pages.PrivacyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      FontFamily="{DynamicResource AppFontFamily}"
      FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,36,36"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <TextBlock Text="隐私" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="清楚了解哪些内容留在设备上，哪些文字会发送给 DeepSeek。"
                       Style="{StaticResource PageSubtitleStyle}" />

            <ui:InfoBar Title="截图始终留在本机"
                        Message="框选截图只用于本地 OCR，会话完成后从内存释放。发送到 DeepSeek 的只有 OCR 文字。"
                        Severity="Success"
                        IsOpen="True"
                        Margin="0,0,0,18" />

            <TextBlock Text="数据使用" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="不保存翻译历史" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Text="当前版本不会将原文、译文或截图写入磁盘；关闭译文窗口后仅保留运行所需的短期内存状态。"
                               Style="{StaticResource SettingDescriptionStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Text="安全说明" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="API Key" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Text="密钥由 Windows 当前用户范围的安全存储保护；日志会隐藏密钥、认证头和完整请求正文。"
                               Style="{StaticResource SettingDescriptionStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="远程处理" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Text="识别后的文字会发送至你配置的 DeepSeek Base URL。请避免框选不希望发送给第三方的敏感文字。"
                               Style="{StaticResource SettingDescriptionStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
