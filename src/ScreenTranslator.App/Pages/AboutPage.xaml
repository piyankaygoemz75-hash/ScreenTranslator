<Page x:Class="ScreenTranslator.App.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      FontFamily="{DynamicResource AppFontFamily}"
      FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,36,36"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <TextBlock Text="关于" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="轻量、克制，专注把屏幕上的文字变成你能顺畅阅读的语言。"
                       Style="{StaticResource PageSubtitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56"
                            Height="56"
                            CornerRadius="14"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="译"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="屏译" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="版本 0.1.0 · Windows x64"
                                   Style="{StaticResource SettingDescriptionStyle}"
                                   Margin="0,4,0,12" />
                        <TextBlock Text="按下 Alt + Shift + T，框选屏幕区域；本地 OCR 识别文字，再由 DeepSeek 完成翻译。"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="组件" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text=".NET 8 · WPF · WPF UI" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Text="界面遵循 Windows 11 Fluent Design，并支持系统浅色、深色和高对比度设置。"
                               Style="{StaticResource SettingDescriptionStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="反馈与诊断" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Text="诊断日志不会记录 API Key、Authorization 请求头、截图或完整翻译正文。"
                               Style="{StaticResource SettingDescriptionStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
