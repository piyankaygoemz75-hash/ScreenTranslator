<Page x:Class="ScreenTranslator.App.Pages.GeneralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      FontFamily="{DynamicResource AppFontFamily}"
      FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,36,36"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <TextBlock Text="常规" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="设置日常使用方式，并随时开始一次屏幕翻译。"
                       Style="{StaticResource PageSubtitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}"
                    Padding="22"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource CompactBadgeStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding CaptureHotkeyText}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="框选并翻译屏幕内容"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="拖动选择区域，松开后自动识别文字并调用 DeepSeek。"
                                   Style="{StaticResource SettingDescriptionStyle}"
                                   Margin="0,6,24,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="开始框选"
                               Appearance="Primary"
                               Padding="20,8"
                               VerticalAlignment="Center"
                               Command="{Binding StartCaptureCommand}" />
                </Grid>
            </Border>

            <TextBlock Text="启动与语言" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="默认目标语言" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="每次翻译默认输出的语言。"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding TargetLanguages}"
                              SelectedItem="{Binding TargetLanguage}"
                              MinWidth="180"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="最小化到系统托盘" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="关闭设置窗口后继续监听翻译快捷键。"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding MinimizeToTray}"
                                     VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开机启动" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="登录 Windows 后自动启动屏译，默认关闭。"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding StartWithWindows}"
                                     VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="网页译文跟随"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,24,0,10" />

            <Border Style="{StaticResource SettingCardStyle}"
                    Padding="22">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Chrome / Edge 普通网页"
                                       Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="只移动现有译文，不会因滚动重复截图、OCR 或调用 AI。页面切换、缩放和窗口大小改变时会自动隐藏旧译文。"
                                       Style="{StaticResource SettingDescriptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding BrowserIntegration.IsEnabled}"
                                         VerticalAlignment="Top" />
                    </Grid>

                    <Border Margin="0,18,0,14"
                            Padding="14,12"
                            CornerRadius="8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Chrome"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="{Binding BrowserIntegration.ChromeStatus}"
                                           Opacity="0.72" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <TextBlock Text="Edge"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="{Binding BrowserIntegration.EdgeStatus}"
                                           Opacity="0.72" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding BrowserIntegration.DetailText}"
                               Style="{StaticResource SettingDescriptionStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <WrapPanel>
                        <ui:Button Content="打开扩展文件夹"
                                   Command="{Binding BrowserIntegration.OpenExtensionFolderCommand}"
                                   Margin="0,0,10,8" />
                        <ui:Button Content="Chrome 扩展页"
                                   Command="{Binding BrowserIntegration.OpenChromeExtensionsCommand}"
                                   Margin="0,0,10,8" />
                        <ui:Button Content="Edge 扩展页"
                                   Command="{Binding BrowserIntegration.OpenEdgeExtensionsCommand}"
                                   Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
