<Page x:Class="ScreenTranslator.App.Pages.TranslationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      FontFamily="{DynamicResource AppFontFamily}"
      FontSize="14">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,36,36"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
            <TextBlock Text="翻译" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="配置 DeepSeek API、翻译方向和输出风格。截图不会发送到云端。"
                       Style="{StaticResource PageSubtitleStyle}" />

            <ui:InfoBar Title="仅发送识别后的文字"
                        Message="API Key 将由应用的安全存储服务加密保存，不写入普通设置文件。"
                        Severity="Informational"
                        IsOpen="True"
                        Margin="0,0,0,18" />

            <TextBlock Text="DeepSeek" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="API Key" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="以 sk- 开头的访问密钥"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <Grid Grid.Column="1" MinWidth="300">
                        <Grid Visibility="{Binding ShowSavedApiKey,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SavedApiKeyMask}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     Padding="10,7" />
                            <ui:Button Grid.Column="1"
                                       Content="更换"
                                       Command="{Binding BeginApiKeyEditCommand}"
                                       Margin="8,0,0,0"
                                       Padding="14,7" />
                        </Grid>

                        <Grid Visibility="{Binding ShowApiKeyEditor,
                                                   Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox"
                                         Padding="10,7"
                                         PasswordChanged="ApiKeyBox_OnPasswordChanged" />
                            <ui:Button Grid.Column="1"
                                       Content="取消"
                                       Command="{Binding CancelApiKeyEditCommand}"
                                       Visibility="{Binding HasSavedApiKey,
                                                            Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="8,0,0,0"
                                       Padding="14,7" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="模型" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="快速响应或更高质量"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Models}"
                              SelectedItem="{Binding SelectedModel}"
                              MinWidth="260" />
                </Grid>
            </Border>

            <Expander Header="高级连接设置" Margin="2,4,2,12">
                <Border Style="{StaticResource SettingCardStyle}"
                        Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Base URL" Style="{StaticResource SettingLabelStyle}" />
                            <TextBlock Text="默认使用 DeepSeek 官方接口"
                                       Style="{StaticResource SettingDescriptionStyle}" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="300" />
                    </Grid>
                </Border>
            </Expander>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ConnectionStatus}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ui:Button Grid.Column="1"
                           Content="测试连接"
                           Command="{Binding TestConnectionCommand}"
                           Margin="8,0" />
                <ui:Button Grid.Column="2"
                           Appearance="Primary"
                           Command="{Binding SaveCommand}">
                    <TextBlock x:Name="SaveButtonText"
                               Text="保存"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </ui:Button>
            </Grid>

            <TextBlock Text="语言与风格" Style="{StaticResource SectionTitleStyle}" />

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="翻译方向" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="自动检测适合大多数屏幕内容。"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding SourceLanguages}"
                              SelectedItem="{Binding SourceLanguage}" />
                    <TextBlock Grid.Column="2"
                               Text="→"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding TargetLanguages}"
                              SelectedItem="{Binding TargetLanguage}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="翻译风格" Style="{StaticResource SettingLabelStyle}" />
                        <TextBlock Text="自然、直译或附带解释的学习模式。"
                                   Style="{StaticResource SettingDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding TranslationStyles}"
                              SelectedItem="{Binding TranslationStyle}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel>
                    <TextBlock Text="上下文与术语" Style="{StaticResource SettingLabelStyle}" />
                    <TextBlock Text="可填写游戏名、角色名、专业领域或固定译法。"
                               Style="{StaticResource SettingDescriptionStyle}"
                               Margin="0,3,0,10" />
                    <TextBox Text="{Binding CustomContext, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="86"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
