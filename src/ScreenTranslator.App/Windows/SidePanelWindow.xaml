<Window x:Class="ScreenTranslator.App.Windows.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="392"
        MinWidth="320"
        MaxWidth="420"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border x:Name="RootCard"
            Margin="14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Opacity="0.97">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="24"
                              ShadowDepth="6"
                              Opacity="0.28" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,15,12,10"
                  MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentFillColorSecondaryBrush}"
                            CornerRadius="999"
                            Padding="9,3">
                        <TextBlock Text="AI 翻译"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding SourceLanguageLabel}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" → "
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TargetLanguageLabel}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           ToolTip="关闭"
                           Padding="8,5"
                           Command="{Binding CloseCommand}">
                    <ui:SymbolIcon Symbol="Dismiss20" />
                </ui:Button>
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="2"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ScrollViewer Grid.Row="2"
                          MaxHeight="510"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,10,18,14">
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsSourceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="原文"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,5" />
                            <TextBlock Text="{Binding SourceText}"
                                       TextWrapping="Wrap"
                                       LineHeight="21" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding TranslatedText}"
                               FontSize="16"
                               LineHeight="25"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,9">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="原文"
                                   ToolTip="显示或隐藏原文"
                                   Command="{Binding ToggleSourceCommand}"
                                   Margin="0,0,6,0" />
                        <ui:Button Content="复制"
                                   Command="{Binding CopyCommand}"
                                   Margin="0,0,6,0" />
                        <ui:Button Content="重译"
                                   Command="{Binding RetryCommand}"
                                   Margin="0,0,6,0" />
                        <ui:Button Content="覆盖"
                                   ToolTip="切换到原位覆盖"
                                   Command="{Binding SwitchModeCommand}" />
                    </StackPanel>
                    <ui:Button Content="固定"
                               Command="{Binding TogglePinCommand}"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
