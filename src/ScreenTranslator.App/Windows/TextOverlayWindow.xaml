<Window x:Class="ScreenTranslator.App.Windows.TextOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        MinWidth="48"
        MinHeight="28"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="RootCard"
            IsHitTestVisible="False"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="9,6"
            Opacity="0.96">
        <Grid>
            <TextBlock x:Name="TranslationText"
                       Text="{Binding TranslatedText}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       LineStackingStrategy="BlockLineHeight" />

            <StackPanel x:Name="ActionBar"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-30,-6,0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ui:Button Content="复制"
                           Padding="7,3"
                           Command="{Binding CopyCommand}" />
                <ui:Button Content="旁显"
                           Padding="7,3"
                           Margin="4,0,0,0"
                           Command="{Binding SwitchModeCommand}" />
                <ui:Button Content="关闭"
                           Padding="7,3"
                           Margin="4,0,0,0"
                           Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
